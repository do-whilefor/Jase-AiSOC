AISOC_ENVIRONMENT=development
AISOC_API_HOST=127.0.0.1
AISOC_API_PORT=8000
AISOC_LOG_LEVEL=INFO
AISOC_LOG_FORMAT=console
AISOC_DATABASE_URL=postgresql://aisoc:aisoc_dev@127.0.0.1:55432/aisoc
# Rust Ingest Base/Standalone raw evidence backend. Linux absolute path only.
AISOC_INGEST_OBJECT_STORE_ROOT=/var/lib/aisoc-raw-evidence

# mTLS Ingest listener. INGEST_HOST is only the bind interface. When it is a
# wildcard (0.0.0.0 or ::), set INGEST_SERVER_NAME to the exact DNS name or IP
# address Agents use so the startup certificate has a verifiable SAN.
AISOC_INGEST_HOST=127.0.0.1
# AISOC_INGEST_SERVER_NAME=ingest.example.internal
AISOC_INGEST_PORT=8001

# P3 deployment profile: base = in-process normalize queue (no NATS);
# stream = NATS JetStream (requires AISOC_NATS_URL + JETSTREAM_ENABLED).
AISOC_DEPLOYMENT_PROFILE=base

# P4 detection engine thresholds (plan §8.3). Defaults are the MVP values.
AISOC_DETECTION_WINDOW_SECONDS=60
AISOC_DETECTION_WEB_SCAN_REQUEST_COUNT=300
AISOC_DETECTION_WEB_SCAN_UNIQUE_PATHS=100
AISOC_DETECTION_WEB_SCAN_4XX_RATIO=0.70
AISOC_DETECTION_WEB_SCAN_SENSITIVE_HITS=5
AISOC_DETECTION_SSH_BRUTEFORCE_FAILURES=10
AISOC_DETECTION_HOST_CHAIN_WINDOW_SECONDS=300
AISOC_DETECTION_LATERAL_SCAN_UNIQUE_HOSTS=20
# Optional deterministic local IOC feed. Configure both values together.
# AISOC_DETECTION_IOC_FEED_PATH=/etc/aisoc/ioc/feed.json
# AISOC_DETECTION_IOC_FEED_SHA256=<64-lowercase-hex-digest>

# P4/P6 pipeline workers (run in-process in the API server lifespan).
# Set to false to disable normalize + detection + Incident background workers.
AISOC_WORKERS_ENABLED=true
AISOC_NORMALIZE_WORKER_POLL_SECONDS=1.0
AISOC_NORMALIZE_WORKER_BATCH_SIZE=100
AISOC_DETECTION_WORKER_POLL_SECONDS=2.0
# Must cover both twice DETECTION_WINDOW_SECONDS and HOST_CHAIN_WINDOW_SECONDS.
AISOC_DETECTION_LOOKBACK_SECONDS=600
# Abort instead of evaluating a silently truncated lookback window.
AISOC_DETECTION_WORKER_MAX_EVENTS=20000

# P6 Incident correlation. LOOKBACK must cover CORRELATION + CONTEXT.
AISOC_INCIDENT_WORKER_POLL_SECONDS=3.0
AISOC_INCIDENT_LOOKBACK_SECONDS=1800
AISOC_INCIDENT_CORRELATION_WINDOW_SECONDS=900
AISOC_INCIDENT_CONTEXT_WINDOW_SECONDS=300
# Abort rather than write a partial Incident/evidence graph.
AISOC_INCIDENT_WORKER_MAX_DETECTIONS=10000
AISOC_INCIDENT_WORKER_MAX_EVENTS=100000

# P7 optional Incident-level AI review. Disabled by default so model failure
# cannot affect deterministic detection/correlation. Never commit a real key.
AISOC_AI_REVIEW_ENABLED=false
AISOC_AI_REVIEW_POLICY_VERSION=p7-policy-v0.1.0
AISOC_AI_REVIEW_MINIMUM_SEVERITY=medium
AISOC_AI_REVIEW_MINIMUM_RISK_SCORE=50
AISOC_AI_REVIEW_MAX_RAW_LOG_SAMPLES=20
AISOC_AI_REVIEW_MAX_CONTEXT_TOKENS=16000
AISOC_AI_REVIEW_MAX_OUTPUT_TOKENS=4000
AISOC_AI_REVIEW_MAX_TOOL_CALLS=8
AISOC_AI_REVIEW_MAX_MODEL_RUNS_PER_INCIDENT=3
AISOC_AI_REVIEW_MAX_REVIEWS_PER_MINUTE=30
AISOC_AI_REVIEW_MAX_COST_USD_PER_INCIDENT=1.0
AISOC_AI_REVIEW_PROVIDER_TIMEOUT_SECONDS=30
AISOC_AI_REVIEW_PROVIDER_MAX_RETRIES=2
AISOC_AI_REVIEW_CIRCUIT_FAILURE_THRESHOLD=3
AISOC_AI_REVIEW_CIRCUIT_RECOVERY_SECONDS=60
AISOC_AI_REVIEW_TOOL_MAX_RESULT_ROWS=50
AISOC_AI_REVIEW_TOOL_MAX_RESULT_BYTES=262144
# P8 deterministic escalation and blind-review slots. All roles share the
# model/tool/cost budgets above; one provider may be called in separate roles.
AISOC_AI_REVIEW_VERIFICATION_MINIMUM_SEVERITY=high
AISOC_AI_REVIEW_VERIFICATION_MINIMUM_RISK_SCORE=80
AISOC_AI_REVIEW_VERIFY_CRITICAL_ASSET=true
AISOC_AI_REVIEW_VERIFY_UNSUPPORTED_CLAIMS=true
AISOC_AI_REVIEW_VERIFY_CONFLICTING_EVIDENCE=true
AISOC_AI_REVIEW_VERIFY_DESTRUCTIVE_ACTION=true
AISOC_AI_REVIEW_MAX_VERIFIER_SLOTS=1
AISOC_AI_REVIEW_ADJUDICATOR_ENABLED=true
# Provider presets (fixed HTTPS base; only set API_KEY + MODEL_NAME):
#   kimi      -> moonshot-v1-32k   https://api.moonshot.cn
#   glm       -> glm-4             https://open.bigmodel.cn/api/paas/v4
#   deepseek  -> deepseek-chat     https://api.deepseek.com
#   openai    -> gpt-4o-mini       https://api.openai.com/v1
# openai_compatible -> custom base_url (loopback HTTP allowed for local vLLM)
AISOC_AI_REVIEW_PROVIDER=openai_compatible
AISOC_AI_REVIEW_BASE_URL=https://model.example/v1-compatible-root
AISOC_AI_REVIEW_MODEL_NAME=replace-with-model-name
AISOC_AI_REVIEW_MODEL_CONTEXT_TOKENS=32000
AISOC_AI_REVIEW_MODEL_MAX_RESPONSE_BYTES=2097152
AISOC_AI_REVIEW_INPUT_COST_PER_MILLION_TOKENS=0
AISOC_AI_REVIEW_OUTPUT_COST_PER_MILLION_TOKENS=0
# AISOC_AI_REVIEW_API_KEY=load-from-a-secret-manager   (never commit)

# P9 malware analysis. Disabled by default. The quarantine key must be a
# dedicated 32-byte base64url secret and must not reuse any API/model/CA key.
AISOC_MALWARE_ANALYSIS_ENABLED=false
AISOC_MALWARE_QUARANTINE_ROOT=var/quarantine
# AISOC_MALWARE_QUARANTINE_KEY=load-32-byte-base64url-from-a-secret-manager
AISOC_MALWARE_MAX_UPLOAD_BYTES=33554432
AISOC_MALWARE_STATIC_MAX_STRINGS=128
AISOC_MALWARE_STATIC_MAX_STRING_LENGTH=256
AISOC_MALWARE_STATIC_MAX_ARCHIVE_ENTRIES=512
AISOC_MALWARE_STATIC_MAX_ARCHIVE_UNCOMPRESSED_BYTES=536870912
AISOC_MALWARE_STATIC_MAX_ARCHIVE_COMPRESSION_RATIO=1000
# This enables only the standalone aisoc-malware-worker process. The API
# server never starts the sample interpretation worker in-process.
AISOC_MALWARE_WORKER_ENABLED=false
AISOC_MALWARE_WORKER_POLL_SECONDS=2.0
AISOC_MALWARE_SCAN_LEASE_SECONDS=300
AISOC_MALWARE_SCAN_MAX_ATTEMPTS=3
# Optional: real YARA-X adapter. Path to a .yara/.yar file or a directory of rule
# files. When unset, the YARA-X engine stays unavailable (builtin-yara-x=not_configured).
# AISOC_MALWARE_YARA_X_RULES_PATH=/etc/aisoc/yara-rules
AISOC_MALWARE_SANDBOX_MAX_REPORT_BYTES=2097152

# P10 on-demand cross-host attack tracing. Candidate Incidents are tenant/time
# bounded; only the seed's evidence-connected component is retained.
AISOC_TRACE_SEARCH_WINDOW_SECONDS=86400
AISOC_TRACE_SESSION_MATCH_SECONDS=120
AISOC_TRACE_LATERAL_FOLLOWUP_SECONDS=300
AISOC_TRACE_MAX_INCIDENTS=4096
AISOC_TRACE_MAX_EVIDENCE=16384
AISOC_TRACE_MAX_ENTITIES=8192
AISOC_TRACE_MAX_EDGES=16384

# P11 response plans and approvals are available while native execution remains
# disabled. Enable only on a validated Linux Action Runner with fixed adapters.
AISOC_RESPONSE_EXECUTION_ENABLED=false
# The first native implementation is deliberately limited to a worker running
# on the same enrolled Agent host. It must load that private Agent config and
# refuses every action whose tenant/host/agent binding does not match it.
AISOC_RESPONSE_WORKER_ENABLED=false
AISOC_RESPONSE_EXECUTION_PROFILE=none
# AISOC_RESPONSE_LOCAL_AGENT_CONFIG_PATH=/etc/aisoc/agent.json
AISOC_RESPONSE_POLICY_VERSION=p11-response-policy-v0.1.0
AISOC_RESPONSE_FIREWALL_ADAPTER=nftables
AISOC_RESPONSE_FILE_QUARANTINE_ROOT=/var/lib/aisoc/response-quarantine
AISOC_RESPONSE_ALLOWED_FILE_ROOTS=["/opt","/srv","/tmp","/var/tmp"]
AISOC_RESPONSE_MAX_ACTIVE_ACTIONS_PER_INCIDENT=8
AISOC_RESPONSE_MAX_ACTIVE_TARGETS_PER_INCIDENT=4
AISOC_RESPONSE_WORKER_POLL_SECONDS=1.0
AISOC_RESPONSE_EXECUTION_LEASE_SECONDS=300
AISOC_RESPONSE_LIST_LIMIT=100
AISOC_RESPONSE_COMMAND_TIMEOUT_SECONDS=10
AISOC_RESPONSE_COMMAND_MAX_OUTPUT_BYTES=65536
AISOC_RESPONSE_FILE_MAX_BYTES=1073741824
# R3 account actions are unavailable unless exact non-root accounts are listed.
AISOC_RESPONSE_ALLOWED_ACCOUNTS=[]
AISOC_RESPONSE_MIN_ACCOUNT_UID=1000

# P11 signed notification delivery. This is an independent process role and is
# disabled by default. The URL/host allowlist are deployment configuration;
# no request or outbox payload can select a destination. Non-loopback is HTTPS.
AISOC_NOTIFICATION_WORKER_ENABLED=false
AISOC_NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:9000/aisoc-events
AISOC_NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=["127.0.0.1"]
# AISOC_NOTIFICATION_WEBHOOK_SECRET=load-32-byte-base64url-from-a-secret-manager
AISOC_NOTIFICATION_WEBHOOK_KEY_ID=p11-webhook-v1
AISOC_NOTIFICATION_WORKER_POLL_SECONDS=1.0
AISOC_NOTIFICATION_DELIVERY_LEASE_SECONDS=60
AISOC_NOTIFICATION_MAX_ATTEMPTS=5
AISOC_NOTIFICATION_RETRY_BASE_SECONDS=5
AISOC_NOTIFICATION_RETRY_MAX_SECONDS=300
AISOC_NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10
AISOC_NOTIFICATION_WEBHOOK_MAX_RESPONSE_BYTES=65536

# Development-only credentials. Generate unique values of at least 24 characters.
AISOC_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-random-admin-token
