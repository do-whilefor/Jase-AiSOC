BLUE_TEAM_ENVIRONMENT=development
BLUE_TEAM_API_HOST=127.0.0.1
BLUE_TEAM_API_PORT=8000
BLUE_TEAM_LOG_LEVEL=INFO
BLUE_TEAM_LOG_FORMAT=console
BLUE_TEAM_DATABASE_URL=postgresql+asyncpg://blue_team:blue_team_dev@127.0.0.1:55432/blue_team
BLUE_TEAM_OBJECT_STORE_ROOT=var/evidence

# P3 deployment profile: base = in-process normalize queue (no NATS);
# stream = NATS JetStream (requires BLUE_TEAM_NATS_URL + JETSTREAM_ENABLED).
BLUE_TEAM_DEPLOYMENT_PROFILE=base

# P4 detection engine thresholds (plan §8.3). Defaults are the MVP values.
BLUE_TEAM_DETECTION_WINDOW_SECONDS=60
BLUE_TEAM_DETECTION_WEB_SCAN_REQUEST_COUNT=300
BLUE_TEAM_DETECTION_WEB_SCAN_UNIQUE_PATHS=100
BLUE_TEAM_DETECTION_WEB_SCAN_4XX_RATIO=0.70
BLUE_TEAM_DETECTION_WEB_SCAN_SENSITIVE_HITS=5
BLUE_TEAM_DETECTION_SSH_BRUTEFORCE_FAILURES=10
BLUE_TEAM_DETECTION_HOST_CHAIN_WINDOW_SECONDS=300
BLUE_TEAM_DETECTION_LATERAL_SCAN_UNIQUE_HOSTS=20

# P4/P6 pipeline workers (run in-process in the API server lifespan).
# Set to false to disable normalize + detection + Incident background workers.
BLUE_TEAM_WORKERS_ENABLED=true
BLUE_TEAM_NORMALIZE_WORKER_POLL_SECONDS=1.0
BLUE_TEAM_NORMALIZE_WORKER_BATCH_SIZE=100
BLUE_TEAM_DETECTION_WORKER_POLL_SECONDS=2.0
# Must cover both twice DETECTION_WINDOW_SECONDS and HOST_CHAIN_WINDOW_SECONDS.
BLUE_TEAM_DETECTION_LOOKBACK_SECONDS=600
# Abort instead of evaluating a silently truncated lookback window.
BLUE_TEAM_DETECTION_WORKER_MAX_EVENTS=20000

# P6 Incident correlation. LOOKBACK must cover CORRELATION + CONTEXT.
BLUE_TEAM_INCIDENT_WORKER_POLL_SECONDS=3.0
BLUE_TEAM_INCIDENT_LOOKBACK_SECONDS=1800
BLUE_TEAM_INCIDENT_CORRELATION_WINDOW_SECONDS=900
BLUE_TEAM_INCIDENT_CONTEXT_WINDOW_SECONDS=300
# Abort rather than write a partial Incident/evidence graph.
BLUE_TEAM_INCIDENT_WORKER_MAX_DETECTIONS=10000
BLUE_TEAM_INCIDENT_WORKER_MAX_EVENTS=100000

# P7 optional Incident-level AI review. Disabled by default so model failure
# cannot affect deterministic detection/correlation. Never commit a real key.
BLUE_TEAM_AI_REVIEW_ENABLED=false
BLUE_TEAM_AI_REVIEW_POLICY_VERSION=p7-policy-v0.1.0
BLUE_TEAM_AI_REVIEW_MINIMUM_SEVERITY=medium
BLUE_TEAM_AI_REVIEW_MINIMUM_RISK_SCORE=50
BLUE_TEAM_AI_REVIEW_MAX_RAW_LOG_SAMPLES=20
BLUE_TEAM_AI_REVIEW_MAX_CONTEXT_TOKENS=16000
BLUE_TEAM_AI_REVIEW_MAX_OUTPUT_TOKENS=4000
BLUE_TEAM_AI_REVIEW_MAX_TOOL_CALLS=8
BLUE_TEAM_AI_REVIEW_MAX_MODEL_RUNS_PER_INCIDENT=3
BLUE_TEAM_AI_REVIEW_MAX_REVIEWS_PER_MINUTE=30
BLUE_TEAM_AI_REVIEW_MAX_COST_USD_PER_INCIDENT=1.0
BLUE_TEAM_AI_REVIEW_PROVIDER_TIMEOUT_SECONDS=30
BLUE_TEAM_AI_REVIEW_PROVIDER_MAX_RETRIES=2
BLUE_TEAM_AI_REVIEW_CIRCUIT_FAILURE_THRESHOLD=3
BLUE_TEAM_AI_REVIEW_CIRCUIT_RECOVERY_SECONDS=60
BLUE_TEAM_AI_REVIEW_TOOL_MAX_RESULT_ROWS=50
BLUE_TEAM_AI_REVIEW_TOOL_MAX_RESULT_BYTES=262144
# P8 deterministic escalation and blind-review slots. All roles share the
# model/tool/cost budgets above; one provider may be called in separate roles.
BLUE_TEAM_AI_REVIEW_VERIFICATION_MINIMUM_SEVERITY=high
BLUE_TEAM_AI_REVIEW_VERIFICATION_MINIMUM_RISK_SCORE=80
BLUE_TEAM_AI_REVIEW_VERIFY_CRITICAL_ASSET=true
BLUE_TEAM_AI_REVIEW_VERIFY_UNSUPPORTED_CLAIMS=true
BLUE_TEAM_AI_REVIEW_VERIFY_CONFLICTING_EVIDENCE=true
BLUE_TEAM_AI_REVIEW_VERIFY_DESTRUCTIVE_ACTION=true
BLUE_TEAM_AI_REVIEW_MAX_VERIFIER_SLOTS=1
BLUE_TEAM_AI_REVIEW_ADJUDICATOR_ENABLED=true
# openai_compatible | kimi | glm
BLUE_TEAM_AI_REVIEW_PROVIDER=openai_compatible
BLUE_TEAM_AI_REVIEW_BASE_URL=https://model.example/v1-compatible-root
BLUE_TEAM_AI_REVIEW_MODEL_NAME=replace-with-model-name
BLUE_TEAM_AI_REVIEW_MODEL_CONTEXT_TOKENS=32000
BLUE_TEAM_AI_REVIEW_MODEL_MAX_RESPONSE_BYTES=2097152
BLUE_TEAM_AI_REVIEW_INPUT_COST_PER_MILLION_TOKENS=0
BLUE_TEAM_AI_REVIEW_OUTPUT_COST_PER_MILLION_TOKENS=0
# BLUE_TEAM_AI_REVIEW_API_KEY=load-from-a-secret-manager

# P9 malware analysis. Disabled by default. The quarantine key must be a
# dedicated 32-byte base64url secret and must not reuse any API/model/CA key.
BLUE_TEAM_MALWARE_ANALYSIS_ENABLED=false
BLUE_TEAM_MALWARE_QUARANTINE_ROOT=var/quarantine
# BLUE_TEAM_MALWARE_QUARANTINE_KEY=load-32-byte-base64url-from-a-secret-manager
BLUE_TEAM_MALWARE_MAX_UPLOAD_BYTES=33554432
BLUE_TEAM_MALWARE_STATIC_MAX_STRINGS=128
BLUE_TEAM_MALWARE_STATIC_MAX_STRING_LENGTH=256
BLUE_TEAM_MALWARE_STATIC_MAX_ARCHIVE_ENTRIES=512
BLUE_TEAM_MALWARE_STATIC_MAX_ARCHIVE_UNCOMPRESSED_BYTES=536870912
BLUE_TEAM_MALWARE_STATIC_MAX_ARCHIVE_COMPRESSION_RATIO=1000
# This enables only the standalone blue-team-malware-worker process. The API
# server never starts the sample interpretation worker in-process.
BLUE_TEAM_MALWARE_WORKER_ENABLED=false
BLUE_TEAM_MALWARE_WORKER_POLL_SECONDS=2.0
BLUE_TEAM_MALWARE_SCAN_LEASE_SECONDS=300
BLUE_TEAM_MALWARE_SCAN_MAX_ATTEMPTS=3
BLUE_TEAM_MALWARE_SANDBOX_MAX_REPORT_BYTES=2097152

# P10 on-demand cross-host attack tracing. Candidate Incidents are tenant/time
# bounded; only the seed's evidence-connected component is retained.
BLUE_TEAM_TRACE_SEARCH_WINDOW_SECONDS=86400
BLUE_TEAM_TRACE_SESSION_MATCH_SECONDS=120
BLUE_TEAM_TRACE_LATERAL_FOLLOWUP_SECONDS=300
BLUE_TEAM_TRACE_MAX_INCIDENTS=4096
BLUE_TEAM_TRACE_MAX_EVIDENCE=16384
BLUE_TEAM_TRACE_MAX_ENTITIES=8192
BLUE_TEAM_TRACE_MAX_EDGES=16384

# P11 response plans and approvals are available while native execution remains
# disabled. Enable only on a validated Linux Action Runner with fixed adapters.
BLUE_TEAM_RESPONSE_EXECUTION_ENABLED=false
# The first native implementation is deliberately limited to a worker running
# on the same enrolled Agent host. It must load that private Agent config and
# refuses every action whose tenant/host/agent binding does not match it.
BLUE_TEAM_RESPONSE_WORKER_ENABLED=false
BLUE_TEAM_RESPONSE_EXECUTION_PROFILE=none
# BLUE_TEAM_RESPONSE_LOCAL_AGENT_CONFIG_PATH=/etc/blue-team/agent.json
BLUE_TEAM_RESPONSE_POLICY_VERSION=p11-response-policy-v0.1.0
BLUE_TEAM_RESPONSE_FIREWALL_ADAPTER=nftables
BLUE_TEAM_RESPONSE_FILE_QUARANTINE_ROOT=/var/lib/blue-team/response-quarantine
BLUE_TEAM_RESPONSE_ALLOWED_FILE_ROOTS=["/opt","/srv","/tmp","/var/tmp"]
BLUE_TEAM_RESPONSE_MAX_ACTIVE_ACTIONS_PER_INCIDENT=8
BLUE_TEAM_RESPONSE_MAX_ACTIVE_TARGETS_PER_INCIDENT=4
BLUE_TEAM_RESPONSE_WORKER_POLL_SECONDS=1.0
BLUE_TEAM_RESPONSE_EXECUTION_LEASE_SECONDS=300
BLUE_TEAM_RESPONSE_LIST_LIMIT=100
BLUE_TEAM_RESPONSE_COMMAND_TIMEOUT_SECONDS=10
BLUE_TEAM_RESPONSE_COMMAND_MAX_OUTPUT_BYTES=65536
BLUE_TEAM_RESPONSE_FILE_MAX_BYTES=1073741824
# R3 account actions are unavailable unless exact non-root accounts are listed.
BLUE_TEAM_RESPONSE_ALLOWED_ACCOUNTS=[]
BLUE_TEAM_RESPONSE_MIN_ACCOUNT_UID=1000

# P11 signed notification delivery. This is an independent process role and is
# disabled by default. The URL/host allowlist are deployment configuration;
# no request or outbox payload can select a destination. Non-loopback is HTTPS.
BLUE_TEAM_NOTIFICATION_WORKER_ENABLED=false
BLUE_TEAM_NOTIFICATION_WEBHOOK_URL=http://127.0.0.1:9000/blue-team-events
BLUE_TEAM_NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=["127.0.0.1"]
# BLUE_TEAM_NOTIFICATION_WEBHOOK_SECRET=load-32-byte-base64url-from-a-secret-manager
BLUE_TEAM_NOTIFICATION_WEBHOOK_KEY_ID=p11-webhook-v1
BLUE_TEAM_NOTIFICATION_WORKER_POLL_SECONDS=1.0
BLUE_TEAM_NOTIFICATION_DELIVERY_LEASE_SECONDS=60
BLUE_TEAM_NOTIFICATION_MAX_ATTEMPTS=5
BLUE_TEAM_NOTIFICATION_RETRY_BASE_SECONDS=5
BLUE_TEAM_NOTIFICATION_RETRY_MAX_SECONDS=300
BLUE_TEAM_NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10
BLUE_TEAM_NOTIFICATION_WEBHOOK_MAX_RESPONSE_BYTES=65536

# Development-only credentials. Generate unique values of at least 24 characters.
BLUE_TEAM_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-random-admin-token
