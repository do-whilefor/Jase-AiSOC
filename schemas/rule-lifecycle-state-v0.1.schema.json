{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RuleEmissionScope": {
      "enum": [
        "disabled",
        "shadow_only",
        "canary_hosts",
        "all_hosts"
      ],
      "title": "RuleEmissionScope",
      "type": "string"
    },
    "RuleLifecycleStage": {
      "enum": [
        "draft",
        "shadow",
        "canary",
        "released",
        "deprecated"
      ],
      "title": "RuleLifecycleStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "rule_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/RuleLifecycleStage"
    },
    "emission_scope": {
      "$ref": "#/$defs/RuleEmissionScope"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "catalog_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "signing_key_id": {
      "pattern": "^[A-Za-z0-9_.-]{3,128}$",
      "title": "Signing Key Id",
      "type": "string"
    },
    "canary_host_ids": {
      "default": [],
      "items": {
        "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Canary Host Ids",
      "type": "array"
    },
    "validation_evidence_count": {
      "maximum": 32,
      "minimum": 0,
      "title": "Validation Evidence Count",
      "type": "integer"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "applied_at": {
      "format": "date-time",
      "title": "Applied At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "rule_id",
    "rule_version",
    "sequence",
    "stage",
    "emission_scope",
    "manifest_sha256",
    "catalog_sha256",
    "signing_key_id",
    "validation_evidence_count",
    "issued_at",
    "expires_at",
    "applied_at"
  ],
  "title": "RuleLifecycleStateRead",
  "type": "object"
}
