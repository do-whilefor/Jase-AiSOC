{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aisoc.local/v0.1/model-assessment-v0.1.schema.json",
  "title": "ModelAssessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "risk_score",
    "confidence",
    "attack_types",
    "target_fields",
    "evasion_detected",
    "evidence_refs",
    "reason_codes",
    "provider_id",
    "model_id",
    "prompt_version"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "benign",
        "suspicious",
        "malicious",
        "unknown"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attack_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "target_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "evasion_detected": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "maxItems": 128
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
