{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AccountResponseTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "account",
          "default": "account",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "username": {
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "title": "Username",
          "type": "string"
        },
        "uid": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "shell": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Shell",
          "type": "string"
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "username",
        "uid",
        "shell",
        "locked"
      ],
      "title": "AccountResponseTarget",
      "type": "object"
    },
    "EvidenceCollectionKind": {
      "enum": [
        "logs",
        "process_tree",
        "file_metadata",
        "pcap"
      ],
      "title": "EvidenceCollectionKind",
      "type": "string"
    },
    "EvidenceCollectionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "evidence_collection",
          "default": "evidence_collection",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "collections": {
          "items": {
            "$ref": "#/$defs/EvidenceCollectionKind"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Collections",
          "type": "array"
        },
        "max_bytes": {
          "maximum": 1073741824,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        },
        "duration_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Duration Seconds",
          "type": "integer"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "collections",
        "max_bytes"
      ],
      "title": "EvidenceCollectionTarget",
      "type": "object"
    },
    "FileResponseTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "file",
          "default": "file",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "gid": {
          "minimum": 0,
          "title": "Gid",
          "type": "integer"
        },
        "mode": {
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "path",
        "sha256",
        "inode",
        "device",
        "uid",
        "gid",
        "mode"
      ],
      "title": "FileResponseTarget",
      "type": "object"
    },
    "HostResponseTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "host",
          "default": "host",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "management_ip": {
          "maxLength": 45,
          "minLength": 2,
          "title": "Management Ip",
          "type": "string"
        },
        "allowlist_ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowlist Ips",
          "type": "array"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "management_ip",
        "allowlist_ips"
      ],
      "title": "HostResponseTarget",
      "type": "object"
    },
    "IpResponseTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "ip",
          "default": "ip",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "ip_address": {
          "maxLength": 45,
          "minLength": 2,
          "title": "Ip Address",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "ip_address"
      ],
      "title": "IpResponseTarget",
      "type": "object"
    },
    "ProcessResponseTarget": {
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "const": "process",
          "default": "process",
          "title": "Target Type",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "expected_agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Expected Agent Id",
          "type": "string"
        },
        "pid": {
          "maximum": 2147483647,
          "minimum": 2,
          "title": "Pid",
          "type": "integer"
        },
        "start_ticks": {
          "minimum": 1,
          "title": "Start Ticks",
          "type": "integer"
        },
        "executable_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Executable Path",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "expected_agent_id",
        "pid",
        "start_ticks",
        "executable_path",
        "executable_sha256"
      ],
      "title": "ProcessResponseTarget",
      "type": "object"
    },
    "ResponseActionKind": {
      "enum": [
        "collect_evidence",
        "temporary_block_ip",
        "isolate_file",
        "terminate_process",
        "disable_account",
        "isolate_host"
      ],
      "title": "ResponseActionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident_revision": {
      "minimum": 1,
      "title": "Incident Revision",
      "type": "integer"
    },
    "action": {
      "$ref": "#/$defs/ResponseActionKind"
    },
    "target": {
      "discriminator": {
        "mapping": {
          "account": "#/$defs/AccountResponseTarget",
          "evidence_collection": "#/$defs/EvidenceCollectionTarget",
          "file": "#/$defs/FileResponseTarget",
          "host": "#/$defs/HostResponseTarget",
          "ip": "#/$defs/IpResponseTarget",
          "process": "#/$defs/ProcessResponseTarget"
        },
        "propertyName": "target_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/IpResponseTarget"
        },
        {
          "$ref": "#/$defs/ProcessResponseTarget"
        },
        {
          "$ref": "#/$defs/FileResponseTarget"
        },
        {
          "$ref": "#/$defs/AccountResponseTarget"
        },
        {
          "$ref": "#/$defs/HostResponseTarget"
        },
        {
          "$ref": "#/$defs/EvidenceCollectionTarget"
        }
      ],
      "title": "Target"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "ttl_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttl Seconds"
    }
  },
  "required": [
    "incident_revision",
    "action",
    "target",
    "evidence_ids",
    "reason"
  ],
  "title": "ResponsePlanCreate",
  "type": "object"
}
