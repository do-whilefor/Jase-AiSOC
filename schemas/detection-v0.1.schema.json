{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AttackState": {
      "description": "Outcome分层 (§8.3): 区分攻击尝试、阻断、疑似成功与确认失陷。\n\nA single signal (e.g. a scan) must not be reported as a confirmed compromise;\nhigher states require corroborating host-side evidence (P5) that is not yet\navailable, so the engine emits ``UNKNOWN`` rather than over-claiming.",
      "enum": [
        "attack_attempt",
        "blocked",
        "suspected_success",
        "confirmed_compromise",
        "unknown"
      ],
      "title": "AttackState",
      "type": "string"
    },
    "DetectionStatus": {
      "description": "Lifecycle of a detection row: open alerts may be suppressed or resolved.",
      "enum": [
        "open",
        "suppressed",
        "resolved"
      ],
      "title": "DetectionStatus",
      "type": "string"
    },
    "IncidentSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A persisted detection row, returned by the detection repository/API.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "host_id": {
      "title": "Host Id",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "title": "Rule Version",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/IncidentSeverity"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "attack_state": {
      "$ref": "#/$defs/AttackState"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Summary"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "aggregate_metrics": {
      "additionalProperties": true,
      "title": "Aggregate Metrics",
      "type": "object"
    },
    "entity_key": {
      "title": "Entity Key",
      "type": "string"
    },
    "event_time_window_start": {
      "format": "date-time",
      "title": "Event Time Window Start",
      "type": "string"
    },
    "event_time_window_end": {
      "format": "date-time",
      "title": "Event Time Window End",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DetectionStatus"
    },
    "governance_stage": {
      "anyOf": [
        {
          "enum": [
            "canary",
            "released"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Stage"
    },
    "governance_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Manifest Sha256"
    },
    "detection_time": {
      "format": "date-time",
      "title": "Detection Time",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "host_id",
    "rule_id",
    "rule_version",
    "category",
    "severity",
    "confidence",
    "attack_state",
    "summary",
    "evidence_event_ids",
    "aggregate_metrics",
    "entity_key",
    "event_time_window_start",
    "event_time_window_end",
    "status",
    "detection_time",
    "created_at"
  ],
  "title": "DetectionRead",
  "type": "object"
}
