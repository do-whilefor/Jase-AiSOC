{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EntityType": {
      "enum": [
        "host",
        "user",
        "process",
        "file",
        "ip",
        "domain",
        "session",
        "detection_subject"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "IncidentEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^edg_[a-f0-9]{24}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Target Entity Id",
          "type": "string"
        },
        "relationship": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Relationship",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "source_entity_id",
        "target_entity_id",
        "relationship",
        "first_seen",
        "last_seen",
        "evidence_event_ids",
        "evidence_count"
      ],
      "title": "IncidentEdge",
      "type": "object"
    },
    "IncidentEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "canonical_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Key",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "maxProperties": 32,
          "title": "Attributes",
          "type": "object"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_key",
        "first_seen",
        "last_seen"
      ],
      "title": "IncidentEntity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "maxLength": 132,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/IncidentEntity"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/IncidentEdge"
      },
      "maxItems": 8192,
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "incident_id",
    "tenant_id",
    "revision",
    "entities",
    "edges"
  ],
  "title": "IncidentGraphBundle",
  "type": "object"
}
