{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aisoc.local/v0.1/web-request-envelope-v0.1.schema.json",
  "title": "WebRequestEnvelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "tenant_id",
    "service_id",
    "src_ip",
    "method",
    "scheme",
    "host",
    "raw_uri",
    "canonical_uri",
    "selected_headers",
    "content_length",
    "query_fields",
    "body_fields",
    "body_sha256",
    "waf_rule_ids",
    "guard_rule_hits",
    "policy_decision",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string"
    },
    "src_ip": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "scheme": {
      "type": "string",
      "enum": [
        "http",
        "https"
      ]
    },
    "host": {
      "type": "string"
    },
    "raw_uri": {
      "type": "string",
      "maxLength": 262144
    },
    "canonical_uri": {
      "type": "string",
      "maxLength": 262144
    },
    "selected_headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "maxProperties": 64
    },
    "content_type": {
      "type": "string",
      "maxLength": 512
    },
    "content_length": {
      "type": "integer",
      "minimum": 0
    },
    "query_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 2048
        },
        "maxItems": 64
      },
      "maxProperties": 128
    },
    "body_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 2048
      },
      "maxProperties": 128
    },
    "body_sample": {
      "type": "string",
      "maxLength": 65536
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "waf_verdict": {
      "type": "string",
      "maxLength": 128
    },
    "waf_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 128
    },
    "guard_rule_hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule_hit"
      },
      "maxItems": 128
    },
    "model_assessment_ref": {
      "type": "string"
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "MONITOR",
        "CHALLENGE",
        "RATE_LIMIT",
        "BLOCK"
      ]
    },
    "received_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rule_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_version",
        "category",
        "confidence",
        "risk_score",
        "matched_fields",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "matched_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "maxItems": 128
        }
      }
    }
  }
}
