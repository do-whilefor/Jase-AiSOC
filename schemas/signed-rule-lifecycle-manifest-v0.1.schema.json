{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RuleLifecycleChangeKind": {
      "enum": [
        "promote",
        "rollback",
        "upgrade",
        "deprecate"
      ],
      "title": "RuleLifecycleChangeKind",
      "type": "string"
    },
    "RuleLifecycleManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rule-lifecycle-manifest-v0.1",
          "default": "rule-lifecycle-manifest-v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^rlm_[a-f0-9]{32}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "shadow",
            "canary",
            "released",
            "deprecated"
          ],
          "title": "Stage",
          "type": "string"
        },
        "change_kind": {
          "$ref": "#/$defs/RuleLifecycleChangeKind"
        },
        "previous_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Manifest Sha256"
        },
        "catalog_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalog Sha256",
          "type": "string"
        },
        "validation_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleValidationEvidence"
          },
          "maxItems": 32,
          "title": "Validation Evidence",
          "type": "array"
        },
        "canary_host_ids": {
          "default": [],
          "items": {
            "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Canary Host Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "tenant_id",
        "rule_id",
        "rule_version",
        "sequence",
        "stage",
        "change_kind",
        "catalog_sha256",
        "reason",
        "issued_at",
        "expires_at"
      ],
      "title": "RuleLifecycleManifest",
      "type": "object"
    },
    "RuleValidationEvidence": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "dataset_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Sha256",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
        },
        "runner_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Runner Version",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "dataset_sha256",
        "result_sha256",
        "runner_version",
        "executed_at"
      ],
      "title": "RuleValidationEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "signed-rule-lifecycle-manifest-v0.1",
      "default": "signed-rule-lifecycle-manifest-v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[A-Za-z0-9_.-]{3,128}$",
      "title": "Key Id",
      "type": "string"
    },
    "algorithm": {
      "const": "ed25519",
      "default": "ed25519",
      "title": "Algorithm",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/RuleLifecycleManifest"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]{86}(?:==)?$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "key_id",
    "manifest",
    "signature"
  ],
  "title": "SignedRuleLifecycleManifest",
  "type": "object"
}
