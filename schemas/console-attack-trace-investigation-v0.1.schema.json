{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AttackState": {
      "description": "Outcome分层 (§8.3): 区分攻击尝试、阻断、疑似成功与确认失陷。\n\nA single signal (e.g. a scan) must not be reported as a confirmed compromise;\nhigher states require corroborating host-side evidence (P5) that is not yet\navailable, so the engine emits ``UNKNOWN`` rather than over-claiming.",
      "enum": [
        "attack_attempt",
        "blocked",
        "suspected_success",
        "confirmed_compromise",
        "unknown"
      ],
      "title": "AttackState",
      "type": "string"
    },
    "ConsoleTraceEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^ted_[a-f0-9]{24}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Target Entity Id",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/TraceRelationship"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "edge_id",
        "source_entity_id",
        "target_entity_id",
        "relationship",
        "first_seen",
        "last_seen",
        "evidence_count",
        "confidence"
      ],
      "title": "ConsoleTraceEdge",
      "type": "object"
    },
    "ConsoleTraceEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/TraceEntityType"
        },
        "canonical_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Key",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_key",
        "first_seen",
        "last_seen"
      ],
      "title": "ConsoleTraceEntity",
      "type": "object"
    },
    "ConsoleTraceEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "trace_evidence_id": {
          "pattern": "^tev_[a-f0-9]{24}$",
          "title": "Trace Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "pattern": "^inc_[a-f0-9]{32}$",
          "title": "Incident Id",
          "type": "string"
        },
        "incident_revision": {
          "minimum": 1,
          "title": "Incident Revision",
          "type": "integer"
        },
        "incident_evidence_id": {
          "pattern": "^evi_[a-f0-9]{24}$",
          "title": "Incident Evidence Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Type",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "source_time_quality": {
          "enum": [
            "trusted",
            "skew_detected",
            "untrusted"
          ],
          "title": "Source Time Quality",
          "type": "string"
        },
        "is_late": {
          "default": false,
          "title": "Is Late",
          "type": "boolean"
        }
      },
      "required": [
        "trace_evidence_id",
        "incident_id",
        "incident_revision",
        "incident_evidence_id",
        "event_id",
        "event_type",
        "event_time",
        "host_id",
        "source_time_quality"
      ],
      "title": "ConsoleTraceEvidenceRef",
      "type": "object"
    },
    "ConsoleTraceInfrastructureCluster": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "pattern": "^icl_[a-f0-9]{24}$",
          "title": "Cluster Id",
          "type": "string"
        },
        "observable_type": {
          "enum": [
            "ip",
            "domain",
            "certificate",
            "file_hash"
          ],
          "title": "Observable Type",
          "type": "string"
        },
        "canonical_value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Value",
          "type": "string"
        },
        "host_count": {
          "minimum": 1,
          "title": "Host Count",
          "type": "integer"
        },
        "host_ids": {
          "default": [],
          "items": {
            "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Host Ids",
          "type": "array"
        },
        "incident_count": {
          "minimum": 1,
          "title": "Incident Count",
          "type": "integer"
        },
        "incident_ids": {
          "default": [],
          "items": {
            "pattern": "^inc_[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Incident Ids",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Ids",
          "type": "array"
        },
        "similarity_basis": {
          "const": "exact_observable_match",
          "default": "exact_observable_match",
          "title": "Similarity Basis",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "observable_type",
        "canonical_value",
        "host_count",
        "incident_count",
        "evidence_count"
      ],
      "title": "ConsoleTraceInfrastructureCluster",
      "type": "object"
    },
    "ConsoleTraceSectionCounts": {
      "additionalProperties": false,
      "properties": {
        "source_incidents": {
          "minimum": 1,
          "title": "Source Incidents",
          "type": "integer"
        },
        "evidence": {
          "minimum": 1,
          "title": "Evidence",
          "type": "integer"
        },
        "key_path": {
          "minimum": 0,
          "title": "Key Path",
          "type": "integer"
        },
        "impacted_hosts": {
          "minimum": 1,
          "title": "Impacted Hosts",
          "type": "integer"
        },
        "infrastructure_clusters": {
          "minimum": 0,
          "title": "Infrastructure Clusters",
          "type": "integer"
        },
        "techniques": {
          "minimum": 0,
          "title": "Techniques",
          "type": "integer"
        },
        "entities": {
          "minimum": 1,
          "title": "Entities",
          "type": "integer"
        },
        "edges": {
          "minimum": 0,
          "title": "Edges",
          "type": "integer"
        }
      },
      "required": [
        "source_incidents",
        "evidence",
        "key_path",
        "impacted_hosts",
        "infrastructure_clusters",
        "techniques",
        "entities",
        "edges"
      ],
      "title": "ConsoleTraceSectionCounts",
      "type": "object"
    },
    "ConsoleTraceStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^tst_[a-f0-9]{24}$",
          "title": "Step Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TraceStepKind"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "source_host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Source Host Id",
          "type": "string"
        },
        "target_host_id": {
          "anyOf": [
            {
              "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Host Id"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "attack_state": {
          "$ref": "#/$defs/AttackState"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "kind",
        "event_time",
        "source_host_id",
        "summary",
        "attack_state",
        "evidence_count"
      ],
      "title": "ConsoleTraceStep",
      "type": "object"
    },
    "ConsoleTraceTechnique": {
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tactic": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tactic",
          "type": "string"
        },
        "mapping_version": {
          "const": "p10-attack-map-v0.1.0",
          "default": "p10-attack-map-v0.1.0",
          "title": "Mapping Version",
          "type": "string"
        },
        "epistemic_status": {
          "$ref": "#/$defs/TechniqueEpistemicStatus"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Ids",
          "type": "array"
        },
        "source_rule_count": {
          "minimum": 1,
          "title": "Source Rule Count",
          "type": "integer"
        },
        "source_rule_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "technique_id",
        "name",
        "tactic",
        "epistemic_status",
        "evidence_count",
        "source_rule_count"
      ],
      "title": "ConsoleTraceTechnique",
      "type": "object"
    },
    "IncidentSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "TechniqueEpistemicStatus": {
      "enum": [
        "observed",
        "inferred"
      ],
      "title": "TechniqueEpistemicStatus",
      "type": "string"
    },
    "TraceEntityType": {
      "enum": [
        "host",
        "user",
        "process",
        "file",
        "ip",
        "domain",
        "certificate",
        "session",
        "technique",
        "incident"
      ],
      "title": "TraceEntityType",
      "type": "string"
    },
    "TraceRelationship": {
      "enum": [
        "contains",
        "runs_process",
        "spawned",
        "acts_as",
        "logged_into",
        "created_file",
        "accessed_file",
        "executed_file",
        "stores_file",
        "connects_to",
        "targets",
        "observed_session",
        "communicates_with",
        "lateral_to",
        "resolves",
        "presents_certificate",
        "observed_technique",
        "shares_infrastructure"
      ],
      "title": "TraceRelationship",
      "type": "string"
    },
    "TraceRevisionReason": {
      "enum": [
        "initial_trace",
        "late_evidence_recompute",
        "source_revision_recompute"
      ],
      "title": "TraceRevisionReason",
      "type": "string"
    },
    "TraceSourceIncident": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "primary_host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Primary Host Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IncidentSeverity"
        },
        "attack_state": {
          "$ref": "#/$defs/AttackState"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "revision",
        "primary_host_id",
        "severity",
        "attack_state",
        "first_seen",
        "last_seen"
      ],
      "title": "TraceSourceIncident",
      "type": "object"
    },
    "TraceStepKind": {
      "enum": [
        "initial_access",
        "host_execution",
        "persistence",
        "privilege_or_account_change",
        "outbound_connection",
        "lateral_movement",
        "impact"
      ],
      "title": "TraceStepKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bounded, evidence-closed P10 technical trace for the operator console.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^trc_[a-f0-9]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_reason": {
      "$ref": "#/$defs/TraceRevisionReason"
    },
    "seed_incident_id": {
      "pattern": "^inc_[a-f0-9]{32}$",
      "title": "Seed Incident Id",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "attack_state": {
      "$ref": "#/$defs/AttackState"
    },
    "counts": {
      "$ref": "#/$defs/ConsoleTraceSectionCounts"
    },
    "source_incidents": {
      "items": {
        "$ref": "#/$defs/TraceSourceIncident"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Source Incidents",
      "type": "array"
    },
    "initial_access": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsoleTraceStep"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "key_path": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConsoleTraceStep"
      },
      "maxItems": 100,
      "title": "Key Path",
      "type": "array"
    },
    "impacted_host_ids": {
      "items": {
        "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Impacted Host Ids",
      "type": "array"
    },
    "infrastructure_clusters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConsoleTraceInfrastructureCluster"
      },
      "maxItems": 50,
      "title": "Infrastructure Clusters",
      "type": "array"
    },
    "techniques": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConsoleTraceTechnique"
      },
      "maxItems": 50,
      "title": "Techniques",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ConsoleTraceEvidenceRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/ConsoleTraceEntity"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConsoleTraceEdge"
      },
      "maxItems": 400,
      "title": "Edges",
      "type": "array"
    },
    "identity_attribution_status": {
      "const": "not_attributed",
      "default": "not_attributed",
      "title": "Identity Attribution Status",
      "type": "string"
    },
    "identity_assertion_count": {
      "const": 0,
      "default": 0,
      "title": "Identity Assertion Count",
      "type": "integer"
    },
    "identity_attribution_reason": {
      "const": "no_verified_identity_evidence",
      "default": "no_verified_identity_evidence",
      "title": "Identity Attribution Reason",
      "type": "string"
    },
    "attribution_limitations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Attribution Limitations",
      "type": "array"
    },
    "raw_ref_included": {
      "const": false,
      "default": false,
      "title": "Raw Ref Included",
      "type": "boolean"
    },
    "raw_evidence_bytes_included": {
      "const": false,
      "default": false,
      "title": "Raw Evidence Bytes Included",
      "type": "boolean"
    },
    "interactive_graph_query_available": {
      "const": false,
      "default": false,
      "title": "Interactive Graph Query Available",
      "type": "boolean"
    },
    "investigation_export_available": {
      "const": false,
      "default": false,
      "title": "Investigation Export Available",
      "type": "boolean"
    },
    "truncated_sections": {
      "default": [],
      "items": {
        "enum": [
          "source_incidents",
          "evidence",
          "key_path",
          "impacted_hosts",
          "infrastructure_clusters",
          "techniques",
          "entities",
          "edges"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "title": "Truncated Sections",
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "trace_id",
    "revision",
    "revision_reason",
    "seed_incident_id",
    "first_seen",
    "last_seen",
    "attack_state",
    "counts",
    "source_incidents",
    "impacted_host_ids",
    "evidence",
    "entities",
    "attribution_limitations"
  ],
  "title": "ConsoleAttackTraceInvestigation",
  "type": "object"
}
