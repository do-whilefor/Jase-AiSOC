{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalyzerClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^aic_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        },
        "support_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Support Score",
          "type": "number"
        },
        "contradiction_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contradiction Score",
          "type": "number"
        },
        "review_status": {
          "$ref": "#/$defs/ClaimReviewStatus"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Unknowns",
          "type": "array"
        },
        "alternative_explanations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeterministicAssertion"
          },
          "maxItems": 32,
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "category",
        "statement",
        "epistemic_status",
        "support_score",
        "review_status"
      ],
      "title": "AnalyzerClaim",
      "type": "object"
    },
    "AssertionOperator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "ge",
        "lt",
        "le",
        "contains"
      ],
      "title": "AssertionOperator",
      "type": "string"
    },
    "ClaimReviewStatus": {
      "enum": [
        "supported",
        "partially_supported",
        "insufficient",
        "contradicted",
        "unsupported"
      ],
      "title": "ClaimReviewStatus",
      "type": "string"
    },
    "DeterministicAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "pattern": "^ast_[a-f0-9]{24}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "field": {
          "maxLength": 320,
          "pattern": "^(aggregate|evidence|tool)\\.[A-Za-z0-9_.:-]{1,255}$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/AssertionOperator"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Expected"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "assertion_id",
        "field",
        "operator",
        "expected"
      ],
      "title": "DeterministicAssertion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 132,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "summary": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnalyzerClaim"
      },
      "maxItems": 128,
      "title": "Claims",
      "type": "array"
    },
    "overall_unknowns": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Overall Unknowns",
      "type": "array"
    },
    "allowed_response": {
      "const": "recommend_only",
      "default": "recommend_only",
      "title": "Allowed Response",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "summary"
  ],
  "title": "AnalyzerReport",
  "type": "object"
}
