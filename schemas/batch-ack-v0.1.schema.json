{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EventError": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "code",
        "message"
      ],
      "title": "EventError",
      "type": "object"
    }
  },
  "$id": "https://schemas.blue-team-ai.local/batch-ack/v0.1.0",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^batch_[a-f0-9]{32}$",
      "title": "Batch Id",
      "type": "string"
    },
    "accepted_sequence": {
      "minimum": 0,
      "title": "Accepted Sequence",
      "type": "integer"
    },
    "errors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventError"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "accepted_sequence"
  ],
  "title": "BatchAck",
  "type": "object"
}
