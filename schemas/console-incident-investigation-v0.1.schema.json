{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AttackState": {
      "description": "Outcome分层 (§8.3): 区分攻击尝试、阻断、疑似成功与确认失陷。\n\nA single signal (e.g. a scan) must not be reported as a confirmed compromise;\nhigher states require corroborating host-side evidence (P5) that is not yet\navailable, so the engine emits ``UNKNOWN`` rather than over-claiming.",
      "enum": [
        "attack_attempt",
        "blocked",
        "suspected_success",
        "confirmed_compromise",
        "unknown"
      ],
      "title": "AttackState",
      "type": "string"
    },
    "ClaimEpistemicStatus": {
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ],
      "title": "ClaimEpistemicStatus",
      "type": "string"
    },
    "ClaimVerificationStatus": {
      "enum": [
        "supported",
        "contradicted",
        "unsupported"
      ],
      "title": "ClaimVerificationStatus",
      "type": "string"
    },
    "ConsoleIncidentSectionCounts": {
      "additionalProperties": false,
      "properties": {
        "detections": {
          "minimum": 0,
          "title": "Detections",
          "type": "integer"
        },
        "source_evidence": {
          "minimum": 0,
          "title": "Source Evidence",
          "type": "integer"
        },
        "indexed_evidence": {
          "minimum": 0,
          "title": "Indexed Evidence",
          "type": "integer"
        },
        "timeline": {
          "minimum": 0,
          "title": "Timeline",
          "type": "integer"
        },
        "claims": {
          "minimum": 0,
          "title": "Claims",
          "type": "integer"
        },
        "entities": {
          "minimum": 0,
          "title": "Entities",
          "type": "integer"
        },
        "edges": {
          "minimum": 0,
          "title": "Edges",
          "type": "integer"
        }
      },
      "required": [
        "detections",
        "source_evidence",
        "indexed_evidence",
        "timeline",
        "claims",
        "entities",
        "edges"
      ],
      "title": "ConsoleIncidentSectionCounts",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "host",
        "user",
        "process",
        "file",
        "ip",
        "domain",
        "session",
        "detection_subject"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "IncidentClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^clm_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "epistemic_status": {
          "$ref": "#/$defs/ClaimEpistemicStatus"
        },
        "verification_status": {
          "$ref": "#/$defs/ClaimVerificationStatus"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "support_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Support Score",
          "type": "number"
        },
        "contradiction_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contradiction Score",
          "type": "number"
        }
      },
      "required": [
        "claim_id",
        "category",
        "statement",
        "epistemic_status",
        "verification_status",
        "evidence_event_ids",
        "support_score"
      ],
      "title": "IncidentClaim",
      "type": "object"
    },
    "IncidentDataReduction": {
      "additionalProperties": false,
      "properties": {
        "reduction_id": {
          "pattern": "^red_[a-f0-9]{24}$",
          "title": "Reduction Id",
          "type": "string"
        },
        "rule_version": {
          "const": "p6-reduction-v0.1.0",
          "default": "p6-reduction-v0.1.0",
          "title": "Rule Version",
          "type": "string"
        },
        "reason": {
          "const": "incident_context_sampling",
          "default": "incident_context_sampling",
          "title": "Reason",
          "type": "string"
        },
        "input_count": {
          "minimum": 1,
          "title": "Input Count",
          "type": "integer"
        },
        "retained_count": {
          "minimum": 1,
          "title": "Retained Count",
          "type": "integer"
        },
        "dropped_count": {
          "minimum": 0,
          "title": "Dropped Count",
          "type": "integer"
        },
        "sample_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sample Event Ids",
          "type": "array"
        },
        "full_query_ref": {
          "pattern": "^qry_[a-f0-9]{32}$",
          "title": "Full Query Ref",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/IncidentQuerySpec"
        }
      },
      "required": [
        "reduction_id",
        "input_count",
        "retained_count",
        "dropped_count",
        "sample_event_ids",
        "full_query_ref",
        "query"
      ],
      "title": "IncidentDataReduction",
      "type": "object"
    },
    "IncidentEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^edg_[a-f0-9]{24}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Target Entity Id",
          "type": "string"
        },
        "relationship": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Relationship",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "source_entity_id",
        "target_entity_id",
        "relationship",
        "first_seen",
        "last_seen",
        "evidence_event_ids",
        "evidence_count"
      ],
      "title": "IncidentEdge",
      "type": "object"
    },
    "IncidentEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^ent_[a-f0-9]{24}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "canonical_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Key",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "maxProperties": 32,
          "title": "Attributes",
          "type": "object"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_key",
        "first_seen",
        "last_seen"
      ],
      "title": "IncidentEntity",
      "type": "object"
    },
    "IncidentEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^evi_[a-f0-9]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Type",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "raw_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Raw Ref",
          "type": "string"
        },
        "integrity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity Sha256"
        },
        "source_time_quality": {
          "enum": [
            "trusted",
            "skew_detected",
            "untrusted"
          ],
          "title": "Source Time Quality",
          "type": "string"
        },
        "is_late": {
          "default": false,
          "title": "Is Late",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "event_id",
        "event_type",
        "event_time",
        "host_id",
        "raw_ref",
        "source_time_quality"
      ],
      "title": "IncidentEvidenceRef",
      "type": "object"
    },
    "IncidentQuerySpec": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "event_time_from": {
          "format": "date-time",
          "title": "Event Time From",
          "type": "string"
        },
        "event_time_to": {
          "format": "date-time",
          "title": "Event Time To",
          "type": "string"
        },
        "event_types": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Event Types",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "host_id",
        "event_time_from",
        "event_time_to",
        "event_types"
      ],
      "title": "IncidentQuerySpec",
      "type": "object"
    },
    "IncidentSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "investigating",
        "closed"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "IncidentTimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "timeline_id": {
          "pattern": "^tli_[a-f0-9]{24}$",
          "title": "Timeline Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "assurance": {
          "$ref": "#/$defs/TimelineAssurance"
        }
      },
      "required": [
        "timeline_id",
        "event_time",
        "category",
        "summary",
        "evidence_event_ids",
        "assurance"
      ],
      "title": "IncidentTimelineEntry",
      "type": "object"
    },
    "TimelineAssurance": {
      "enum": [
        "trusted",
        "degraded",
        "untrusted"
      ],
      "title": "TimelineAssurance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One revision-consistent, database-bounded operator investigation view.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "incident_id": {
      "pattern": "^inc_[a-f0-9]{32}$",
      "title": "Incident Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "primary_host_id": {
      "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Primary Host Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "severity": {
      "$ref": "#/$defs/IncidentSeverity"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "attack_state": {
      "$ref": "#/$defs/AttackState"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "assurance": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Assurance",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "full_query_ref": {
      "pattern": "^qry_[a-f0-9]{32}$",
      "title": "Full Query Ref",
      "type": "string"
    },
    "aggregate_metrics": {
      "additionalProperties": true,
      "maxProperties": 32,
      "title": "Aggregate Metrics",
      "type": "object"
    },
    "counts": {
      "$ref": "#/$defs/ConsoleIncidentSectionCounts"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentEvidenceRef"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "data_reductions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentDataReduction"
      },
      "maxItems": 8,
      "title": "Data Reductions",
      "type": "array"
    },
    "timeline": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentTimelineEntry"
      },
      "maxItems": 200,
      "title": "Timeline",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentClaim"
      },
      "maxItems": 200,
      "title": "Claims",
      "type": "array"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentEntity"
      },
      "maxItems": 200,
      "title": "Entities",
      "type": "array"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IncidentEdge"
      },
      "maxItems": 400,
      "title": "Edges",
      "type": "array"
    },
    "truncated_sections": {
      "default": [],
      "items": {
        "enum": [
          "evidence",
          "timeline",
          "claims",
          "entities",
          "edges"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "title": "Truncated Sections",
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "incident_id",
    "revision",
    "primary_host_id",
    "status",
    "severity",
    "confidence",
    "risk_score",
    "attack_state",
    "assurance",
    "first_seen",
    "last_seen",
    "full_query_ref",
    "aggregate_metrics",
    "counts"
  ],
  "title": "ConsoleIncidentInvestigation",
  "type": "object"
}
