{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "IncidentEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^evi_[a-f0-9]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Type",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "raw_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Raw Ref",
          "type": "string"
        },
        "integrity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity Sha256"
        },
        "source_time_quality": {
          "enum": [
            "trusted",
            "skew_detected",
            "untrusted"
          ],
          "title": "Source Time Quality",
          "type": "string"
        },
        "is_late": {
          "default": false,
          "title": "Is Late",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "event_id",
        "event_type",
        "event_time",
        "host_id",
        "raw_ref",
        "source_time_quality"
      ],
      "title": "IncidentEvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "review_task_id": {
      "pattern": "^air_[a-f0-9]{32}$",
      "title": "Review Task Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 132,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "incident_revision": {
      "minimum": 1,
      "title": "Incident Revision",
      "type": "integer"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "aggregate_metrics": {
      "additionalProperties": true,
      "maxProperties": 32,
      "title": "Aggregate Metrics",
      "type": "object"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Evidence Ids",
      "type": "array"
    },
    "sample_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Sample Event Ids",
      "type": "array"
    },
    "evidence_index": {
      "items": {
        "$ref": "#/$defs/IncidentEvidenceRef"
      },
      "maxItems": 4096,
      "title": "Evidence Index",
      "type": "array"
    },
    "full_query_ref": {
      "anyOf": [
        {
          "pattern": "^qry_[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Query Ref"
    },
    "available_tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Available Tools",
      "type": "array"
    },
    "data_trust": {
      "const": "untrusted_evidence_data",
      "default": "untrusted_evidence_data",
      "title": "Data Trust",
      "type": "string"
    }
  },
  "required": [
    "review_task_id",
    "tenant_id",
    "incident_id",
    "incident_revision",
    "reason",
    "risk_score",
    "aggregate_metrics",
    "evidence_ids",
    "sample_event_ids",
    "evidence_index"
  ],
  "title": "EvidencePackage",
  "type": "object"
}
