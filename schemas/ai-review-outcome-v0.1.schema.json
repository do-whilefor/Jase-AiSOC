{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdjudicationReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "resolutions": {
          "items": {
            "$ref": "#/$defs/AdjudicationResolution"
          },
          "maxItems": 128,
          "title": "Resolutions",
          "type": "array"
        },
        "unresolved_conflict_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Unresolved Conflict Ids",
          "type": "array"
        },
        "overall_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Overall Unknowns",
          "type": "array"
        },
        "allowed_response": {
          "const": "recommend_only",
          "default": "recommend_only",
          "title": "Allowed Response",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "resolutions"
      ],
      "title": "AdjudicationReport",
      "type": "object"
    },
    "AdjudicationResolution": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^aic_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "final_status": {
          "$ref": "#/$defs/ClaimReviewStatus"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        },
        "rationale": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "final_status",
        "requires_human",
        "rationale"
      ],
      "title": "AdjudicationResolution",
      "type": "object"
    },
    "AnalyzerClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^aic_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "category": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        },
        "support_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Support Score",
          "type": "number"
        },
        "contradiction_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contradiction Score",
          "type": "number"
        },
        "review_status": {
          "$ref": "#/$defs/ClaimReviewStatus"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Unknowns",
          "type": "array"
        },
        "alternative_explanations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeterministicAssertion"
          },
          "maxItems": 32,
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "category",
        "statement",
        "epistemic_status",
        "support_score",
        "review_status"
      ],
      "title": "AnalyzerClaim",
      "type": "object"
    },
    "AnalyzerReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnalyzerClaim"
          },
          "maxItems": 128,
          "title": "Claims",
          "type": "array"
        },
        "overall_unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Overall Unknowns",
          "type": "array"
        },
        "allowed_response": {
          "const": "recommend_only",
          "default": "recommend_only",
          "title": "Allowed Response",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "summary"
      ],
      "title": "AnalyzerReport",
      "type": "object"
    },
    "AssertionOperator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "ge",
        "lt",
        "le",
        "contains"
      ],
      "title": "AssertionOperator",
      "type": "string"
    },
    "AssuranceLevel": {
      "enum": [
        "deterministic_only",
        "unreviewed",
        "basic",
        "enhanced",
        "high"
      ],
      "title": "AssuranceLevel",
      "type": "string"
    },
    "ClaimConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "pattern": "^cnf_[a-f0-9]{24}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^aic_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKind"
        },
        "analyzer_status": {
          "$ref": "#/$defs/ClaimReviewStatus"
        },
        "verifier_slot_id": {
          "anyOf": [
            {
              "pattern": "^vslot_[a-f0-9]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifier Slot Id"
        },
        "verifier_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimReviewStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "claim_id",
        "kind",
        "analyzer_status",
        "detail"
      ],
      "title": "ClaimConflict",
      "type": "object"
    },
    "ClaimProgramVerification": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^aic_[a-f0-9]{24}$",
          "title": "Claim Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProgramVerificationStatus"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeterministicCheck"
          },
          "maxItems": 32,
          "title": "Checks",
          "type": "array"
        },
        "missing_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Missing Evidence Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "status",
        "reason"
      ],
      "title": "ClaimProgramVerification",
      "type": "object"
    },
    "ClaimReviewStatus": {
      "enum": [
        "supported",
        "partially_supported",
        "insufficient",
        "contradicted",
        "unsupported"
      ],
      "title": "ClaimReviewStatus",
      "type": "string"
    },
    "ConflictKind": {
      "enum": [
        "verdict_mismatch",
        "evidence_mismatch",
        "deterministic_contradiction",
        "missing_review"
      ],
      "title": "ConflictKind",
      "type": "string"
    },
    "DeterministicAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "pattern": "^ast_[a-f0-9]{24}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "field": {
          "maxLength": 320,
          "pattern": "^(aggregate|evidence|tool)\\.[A-Za-z0-9_.:-]{1,255}$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/AssertionOperator"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Expected"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "assertion_id",
        "field",
        "operator",
        "expected"
      ],
      "title": "DeterministicAssertion",
      "type": "object"
    },
    "DeterministicCheck": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "pattern": "^ast_[a-f0-9]{24}$",
          "title": "Assertion Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProgramVerificationStatus"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "status",
        "reason"
      ],
      "title": "DeterministicCheck",
      "type": "object"
    },
    "EvidencePackage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "review_task_id": {
          "pattern": "^air_[a-f0-9]{32}$",
          "title": "Review Task Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "incident_revision": {
          "minimum": 1,
          "title": "Incident Revision",
          "type": "integer"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "risk_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Score",
          "type": "integer"
        },
        "aggregate_metrics": {
          "additionalProperties": true,
          "maxProperties": 32,
          "title": "Aggregate Metrics",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Evidence Ids",
          "type": "array"
        },
        "sample_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Sample Event Ids",
          "type": "array"
        },
        "evidence_index": {
          "items": {
            "$ref": "#/$defs/IncidentEvidenceRef"
          },
          "maxItems": 4096,
          "title": "Evidence Index",
          "type": "array"
        },
        "full_query_ref": {
          "anyOf": [
            {
              "pattern": "^qry_[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Query Ref"
        },
        "available_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Available Tools",
          "type": "array"
        },
        "data_trust": {
          "const": "untrusted_evidence_data",
          "default": "untrusted_evidence_data",
          "title": "Data Trust",
          "type": "string"
        }
      },
      "required": [
        "review_task_id",
        "tenant_id",
        "incident_id",
        "incident_revision",
        "reason",
        "risk_score",
        "aggregate_metrics",
        "evidence_ids",
        "sample_event_ids",
        "evidence_index"
      ],
      "title": "EvidencePackage",
      "type": "object"
    },
    "IncidentEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^evi_[a-f0-9]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Type",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "raw_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Raw Ref",
          "type": "string"
        },
        "integrity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity Sha256"
        },
        "source_time_quality": {
          "enum": [
            "trusted",
            "skew_detected",
            "untrusted"
          ],
          "title": "Source Time Quality",
          "type": "string"
        },
        "is_late": {
          "default": false,
          "title": "Is Late",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "event_id",
        "event_type",
        "event_time",
        "host_id",
        "raw_ref",
        "source_time_quality"
      ],
      "title": "IncidentEvidenceRef",
      "type": "object"
    },
    "ModelRole": {
      "enum": [
        "analyzer",
        "verifier",
        "adjudicator"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "ModelRunStatus": {
      "enum": [
        "completed",
        "failed",
        "circuit_open"
      ],
      "title": "ModelRunStatus",
      "type": "string"
    },
    "ModelRunSummary": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^mrun_[a-f0-9]{24}$",
          "title": "Run Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ModelRole"
        },
        "status": {
          "$ref": "#/$defs/ModelRunStatus"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "retry_count": {
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "tool_call_count": {
          "minimum": 0,
          "title": "Tool Call Count",
          "type": "integer"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "degradation_reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation Reason"
        }
      },
      "required": [
        "run_id",
        "provider",
        "model",
        "role",
        "status",
        "evidence_count",
        "latency_ms",
        "retry_count",
        "tool_call_count",
        "request_sha256"
      ],
      "title": "ModelRunSummary",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "title": "ModelUsage",
      "type": "object"
    },
    "ProgramVerificationStatus": {
      "enum": [
        "valid",
        "invalid",
        "indeterminate"
      ],
      "title": "ProgramVerificationStatus",
      "type": "string"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReviewDecisionKind"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "ReviewDecision",
      "type": "object"
    },
    "ReviewDecisionKind": {
      "enum": [
        "skip",
        "analyze",
        "analyze_and_verify",
        "require_human"
      ],
      "title": "ReviewDecisionKind",
      "type": "string"
    },
    "ReviewExecutionStatus": {
      "enum": [
        "skipped",
        "completed",
        "model_unavailable",
        "invalid_output",
        "budget_exceeded",
        "require_human"
      ],
      "title": "ReviewExecutionStatus",
      "type": "string"
    },
    "ReviewProfile": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "analyzer",
          "default": "analyzer",
          "title": "Role",
          "type": "string"
        },
        "prompt_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Prompt Version",
          "type": "string"
        },
        "output_schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Output Schema Version",
          "type": "string"
        },
        "allowed_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Allowed Tools",
          "type": "array"
        }
      },
      "required": [
        "prompt_version"
      ],
      "title": "ReviewProfile",
      "type": "object"
    },
    "ToolCallAudit": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^mrun_[a-f0-9]{24}$",
          "title": "Run Id",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Tool Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolCallAuditStatus"
        },
        "arguments": {
          "additionalProperties": true,
          "maxProperties": 32,
          "title": "Arguments",
          "type": "object"
        },
        "arguments_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Arguments Sha256",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "degradation_reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation Reason"
        }
      },
      "required": [
        "call_id",
        "run_id",
        "tool_name",
        "status",
        "arguments",
        "arguments_sha256"
      ],
      "title": "ToolCallAudit",
      "type": "object"
    },
    "ToolCallAuditStatus": {
      "enum": [
        "completed",
        "rejected"
      ],
      "title": "ToolCallAuditStatus",
      "type": "string"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "maxLength": 128,
