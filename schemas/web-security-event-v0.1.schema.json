{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aisoc.local/v0.1/web-security-event-v0.1.schema.json",
  "title": "WebSecurityEvent v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "request_id",
    "tenant_id",
    "service_id",
    "security_state",
    "policy_decision",
    "risk_score",
    "needs_ai_review",
    "reason_codes",
    "rule_hits",
    "raw_request_sha256",
    "canonical_request_sha256",
    "received_at",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string"
    },
    "security_state": {
      "type": "string",
      "enum": [
        "observed",
        "attack_attempt",
        "blocked",
        "suspected_success",
        "confirmed_compromise"
      ]
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "MONITOR",
        "CHALLENGE",
        "RATE_LIMIT",
        "BLOCK"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "needs_ai_review": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "rule_hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule_hit"
      },
      "maxItems": 128
    },
    "model_assessment": {
      "$ref": "#/$defs/model_assessment"
    },
    "raw_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_at": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rule_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_version",
        "category",
        "confidence",
        "risk_score",
        "matched_fields",
        "evidence_refs"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "matched_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "maxItems": 128
        }
      }
    },
    "model_assessment": {
      "title": "ModelAssessment v0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verdict",
        "risk_score",
        "confidence",
        "attack_types",
        "target_fields",
        "evasion_detected",
        "evidence_refs",
        "reason_codes",
        "provider_id",
        "model_id",
        "prompt_version"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "benign",
            "suspicious",
            "malicious",
            "unknown"
          ]
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attack_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "target_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "evasion_detected": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "maxItems": 128
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
