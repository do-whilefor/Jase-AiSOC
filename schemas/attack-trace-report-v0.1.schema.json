{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AttackState": {
      "description": "Outcome分层 (§8.3): 区分攻击尝试、阻断、疑似成功与确认失陷。\n\nA single signal (e.g. a scan) must not be reported as a confirmed compromise;\nhigher states require corroborating host-side evidence (P5) that is not yet\navailable, so the engine emits ``UNKNOWN`` rather than over-claiming.",
      "enum": [
        "attack_attempt",
        "blocked",
        "suspected_success",
        "confirmed_compromise",
        "unknown"
      ],
      "title": "AttackState",
      "type": "string"
    },
    "IdentityAttribution": {
      "additionalProperties": false,
      "description": "An explicit no-attribution result; P10 never guesses a real identity.",
      "properties": {
        "status": {
          "const": "not_attributed",
          "default": "not_attributed",
          "title": "Status",
          "type": "string"
        },
        "assertion_count": {
          "default": 0,
          "maximum": 0,
          "minimum": 0,
          "title": "Assertion Count",
          "type": "integer"
        },
        "assertions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Assertions",
          "type": "array"
        },
        "reason": {
          "const": "no_verified_identity_evidence",
          "default": "no_verified_identity_evidence",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "IdentityAttribution",
      "type": "object"
    },
    "IncidentSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "InfrastructureCluster": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "pattern": "^icl_[a-f0-9]{24}$",
          "title": "Cluster Id",
          "type": "string"
        },
        "observable_type": {
          "enum": [
            "ip",
            "domain",
            "certificate",
            "file_hash"
          ],
          "title": "Observable Type",
          "type": "string"
        },
        "canonical_value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Value",
          "type": "string"
        },
        "host_ids": {
          "items": {
            "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Host Ids",
          "type": "array"
        },
        "incident_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Incident Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "similarity_basis": {
          "const": "exact_observable_match",
          "default": "exact_observable_match",
          "title": "Similarity Basis",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "observable_type",
        "canonical_value",
        "host_ids",
        "incident_ids",
        "evidence_ids"
      ],
      "title": "InfrastructureCluster",
      "type": "object"
    },
    "TechniqueEpistemicStatus": {
      "enum": [
        "observed",
        "inferred"
      ],
      "title": "TechniqueEpistemicStatus",
      "type": "string"
    },
    "TechniqueMapping": {
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
          "title": "Technique Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tactic": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tactic",
          "type": "string"
        },
        "mapping_version": {
          "const": "p10-attack-map-v0.1.0",
          "default": "p10-attack-map-v0.1.0",
          "title": "Mapping Version",
          "type": "string"
        },
        "epistemic_status": {
          "$ref": "#/$defs/TechniqueEpistemicStatus"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "source_rule_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "technique_id",
        "name",
        "tactic",
        "epistemic_status",
        "evidence_ids",
        "source_rule_ids"
      ],
      "title": "TechniqueMapping",
      "type": "object"
    },
    "TraceEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^ted_[a-f0-9]{24}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Target Entity Id",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/TraceRelationship"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "edge_id",
        "source_entity_id",
        "target_entity_id",
        "relationship",
        "first_seen",
        "last_seen",
        "evidence_ids",
        "evidence_count",
        "confidence"
      ],
      "title": "TraceEdge",
      "type": "object"
    },
    "TraceEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^tge_[a-f0-9]{24}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/TraceEntityType"
        },
        "canonical_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Key",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "maxProperties": 32,
          "title": "Attributes",
          "type": "object"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "canonical_key",
        "first_seen",
        "last_seen"
      ],
      "title": "TraceEntity",
      "type": "object"
    },
    "TraceEntityType": {
      "enum": [
        "host",
        "user",
        "process",
        "file",
        "ip",
        "domain",
        "certificate",
        "session",
        "technique",
        "incident"
      ],
      "title": "TraceEntityType",
      "type": "string"
    },
    "TraceEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "trace_evidence_id": {
          "pattern": "^tev_[a-f0-9]{24}$",
          "title": "Trace Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "incident_revision": {
          "minimum": 1,
          "title": "Incident Revision",
          "type": "integer"
        },
        "incident_evidence_id": {
          "pattern": "^evi_[a-f0-9]{24}$",
          "title": "Incident Evidence Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Type",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Host Id",
          "type": "string"
        },
        "raw_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Raw Ref",
          "type": "string"
        },
        "integrity_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integrity Sha256"
        },
        "source_time_quality": {
          "enum": [
            "trusted",
            "skew_detected",
            "untrusted"
          ],
          "title": "Source Time Quality",
          "type": "string"
        },
        "is_late": {
          "default": false,
          "title": "Is Late",
          "type": "boolean"
        }
      },
      "required": [
        "trace_evidence_id",
        "incident_id",
        "incident_revision",
        "incident_evidence_id",
        "event_id",
        "event_type",
        "event_time",
        "host_id",
        "raw_ref",
        "source_time_quality"
      ],
      "title": "TraceEvidenceRef",
      "type": "object"
    },
    "TraceGraph": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/TraceEntity"
          },
          "maxItems": 8192,
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/TraceEdge"
          },
          "maxItems": 16384,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "entities",
        "edges"
      ],
      "title": "TraceGraph",
      "type": "object"
    },
    "TraceRelationship": {
      "enum": [
        "contains",
        "runs_process",
        "spawned",
        "acts_as",
        "logged_into",
        "created_file",
        "accessed_file",
        "executed_file",
        "stores_file",
        "connects_to",
        "targets",
        "observed_session",
        "communicates_with",
        "lateral_to",
        "resolves",
        "presents_certificate",
        "observed_technique",
        "shares_infrastructure"
      ],
      "title": "TraceRelationship",
      "type": "string"
    },
    "TraceRevisionReason": {
      "enum": [
        "initial_trace",
        "late_evidence_recompute",
        "source_revision_recompute"
      ],
      "title": "TraceRevisionReason",
      "type": "string"
    },
    "TraceSourceIncident": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "maxLength": 132,
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "primary_host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Primary Host Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IncidentSeverity"
        },
        "attack_state": {
          "$ref": "#/$defs/AttackState"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "revision",
        "primary_host_id",
        "severity",
        "attack_state",
        "first_seen",
        "last_seen"
      ],
      "title": "TraceSourceIncident",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^tst_[a-f0-9]{24}$",
          "title": "Step Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TraceStepKind"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "source_host_id": {
          "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
          "title": "Source Host Id",
          "type": "string"
        },
        "target_host_id": {
          "anyOf": [
            {
              "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Host Id"
        },
        "summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "attack_state": {
          "$ref": "#/$defs/AttackState"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^tev_[a-f0-9]{24}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "kind",
        "event_time",
        "source_host_id",
        "summary",
        "attack_state",
        "evidence_ids"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "TraceStepKind": {
      "enum": [
        "initial_access",
        "host_execution",
        "persistence",
        "privilege_or_account_change",
        "outbound_connection",
        "lateral_movement",
        "impact"
      ],
      "title": "TraceStepKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^trc_[a-f0-9]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "revision_reason": {
      "$ref": "#/$defs/TraceRevisionReason"
    },
    "trace_key": {
      "pattern": "^trk_[a-f0-9]{40}$",
      "title": "Trace Key",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^ten_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "seed_incident_id": {
      "maxLength": 132,
      "minLength": 1,
      "title": "Seed Incident Id",
      "type": "string"
    },
    "source_incidents": {
      "items": {
        "$ref": "#/$defs/TraceSourceIncident"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Source Incidents",
      "type": "array"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "attack_state": {
      "$ref": "#/$defs/AttackState"
    },
    "initial_access": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceStep"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "key_path": {
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "maxItems": 10000,
      "title": "Key Path",
      "type": "array"
    },
    "impacted_host_ids": {
      "items": {
        "pattern": "^host_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
        "type": "string"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Impacted Host Ids",
      "type": "array"
    },
    "infrastructure_clusters": {
      "items": {
        "$ref": "#/$defs/InfrastructureCluster"
      },
      "maxItems": 4096,
      "title": "Infrastructure Clusters",
      "type": "array"
    },
    "techniques": {
      "items": {
        "$ref": "#/$defs/TechniqueMapping"
      },
      "maxItems": 1024,
      "title": "Techniques",
      "type": "array"
    },
    "identity_attribution": {
      "$ref": "#/$defs/IdentityAttribution"
    },
    "attribution_limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Attribution Limitations",
      "type": "array"
    },
    "evidence_index": {
      "items": {
        "$ref": "#/$defs/TraceEvidenceRef"
      },
      "maxItems": 16384,
      "minItems": 1,
      "title": "Evidence Index",
      "type": "array"
    },
    "graph": {
      "$ref": "#/$defs/TraceGraph"
    }
  },
  "required": [
    "trace_id",
    "revision",
    "revision_reason",
    "trace_key",
    "tenant_id",
    "seed_incident_id",
    "source_incidents",
    "first_seen",
    "last_seen",
    "attack_state",
    "key_path",
    "impacted_host_ids",
    "infrastructure_clusters",
    "techniques",
    "attribution_limitations",
    "evidence_index",
    "graph"
  ],
  "title": "AttackTraceReport",
  "type": "object"
}
