{
  "format_version": 1,
  "tenant_id": "ten_example001",
  "agent_id": "agent_example001",
  "host_id": "host_example001",
  "boot_id": "replace-with-current-linux-boot-id",
  "state_directory": "/var/lib/aisoc-agent",
  "collectors": {
    "journald_enabled": true,
    "audit_enabled": true,
    "process_enabled": true,
    "network_enabled": true,
    "max_records_per_poll": 256,
    "audit_log_path": "/var/log/audit/audit.log"
  },
  "heartbeat_interval_seconds": 30,
  "poll_interval_ms": 250,
  "max_batch_events": 250,
  "max_batch_bytes": 4194304,
  "ingest_origin": "https://soc.example.internal:8443",
  "client_certificate_path": "/etc/aisoc/agent.crt",
  "client_private_key_path": "/etc/aisoc/agent.key",
  "ca_certificate_path": "/etc/aisoc/agent-ca.crt",
  "transport_timeout_seconds": 15
}
