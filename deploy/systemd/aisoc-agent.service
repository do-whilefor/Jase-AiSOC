[Unit]
Description=AI-SOC Rust endpoint collector Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aisoc
Group=aisoc
UMask=0077
RuntimeDirectory=aisoc-agent
RuntimeDirectoryMode=0700
StateDirectory=aisoc-agent
StateDirectoryMode=0700
EnvironmentFile=-/etc/aisoc/agent.env
ExecStart=/opt/aisoc/current/bin/aisoc-agent run /etc/aisoc/agent-rust.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aisoc-agent
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
