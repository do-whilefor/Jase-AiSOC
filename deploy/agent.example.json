{
  "format_version": 1,
  "tenant_id": "ten_kali001",
  "agent_id": "agent_kali001",
  "host_id": "host_kali001",
  "boot_id": "REPLACE_WITH_$(cat /proc/sys/kernel/random/boot_id)",
  "state_directory": "/var/lib/blue-team-agent",
  "heartbeat_interval_seconds": 30,
  "heartbeat_retry_seconds": 5,
  "poll_interval_seconds": 0.25,
  "ingest_url": "https://127.0.0.1:8001",
  "client_certificate_path": "/etc/blue-team/agent.crt",
  "client_private_key_path": "/etc/blue-team/agent.key",
  "ca_certificate_path": "/etc/blue-team/ca.crt",
  "transport_timeout_seconds": 15.0,
  "upload_backoff_seconds": 5.0,

  "journald_enabled": true,
  "journald_units": ["sshd.service", "nginx.service"],

  "suricata_enabled": true,
  "suricata_log_path": "/var/log/suricata/eve.json",
  "suricata_start_at_end": true,
  "suricata_max_lines_per_poll": 1000,

  "service_log_enabled": true,
  "service_log_path": "/var/log/nginx/access.log",
  "service_log_name": "nginx",
  "service_log_start_at_end": true,
  "service_log_max_lines_per_poll": 1000,

  "auditd_enabled": true,
  "auditd_log_path": "/var/log/audit/audit.log",
  "auditctl_path": "/usr/sbin/auditctl",
  "auditd_start_at_end": true
}
