AISOC_WEB_GUARD_BIND=0.0.0.0:8088
AISOC_WEB_GUARD_UPSTREAM=http://127.0.0.1:8080
AISOC_WEB_GUARD_SCHEME=http
AISOC_WEB_GUARD_MODE=monitor
AISOC_WEB_GUARD_MAX_BODY_BYTES=1048576
AISOC_WEB_GUARD_MAX_BODY_SAMPLE=65536
AISOC_WEB_GUARD_UPSTREAM_TIMEOUT_MS=30000
AISOC_WEB_GUARD_AI_ENABLED=false
AISOC_WEB_GUARD_AI_MAX_RATIO=0.03
AISOC_TENANT_ID=tenant-local
AISOC_SERVICE_ID=web-local
RUST_LOG=aisoc_web_guard=info,aisoc.web_guard.security=info
AISOC_WEB_GUARD_CANARY_BLOCK_RATIO=0.05
AISOC_WEB_GUARD_AI_PROMPT_VERSION=web-guard-v0.1.0
AISOC_WEB_GUARD_AI_TIMEOUT_MS=1500
# Required only when AISOC_WEB_GUARD_AI_ENABLED=true:
# AISOC_WEB_GUARD_AI_BASE_URL=https://model-gateway.example/v1
# AISOC_WEB_GUARD_AI_API_KEY=replace-from-secret-manager
# AISOC_WEB_GUARD_AI_MODEL=security-classifier
