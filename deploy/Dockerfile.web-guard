FROM rust:1.82-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN cargo build --locked --release -p aisoc-web-guard

FROM debian:bookworm-slim
RUN groupadd --gid 10001 aisoc \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /var/lib/aisoc aisoc
COPY --from=builder /build/target/release/aisoc-web-guard /usr/local/bin/aisoc-web-guard
WORKDIR /var/lib/aisoc
USER 10001
EXPOSE 8088
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/aisoc-web-guard"]
